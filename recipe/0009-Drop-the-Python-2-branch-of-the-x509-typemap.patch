From 3333333333333333333333333333333333333333 Mon Sep 17 00:00:00 2001
From: conda-forge <conda-forge@anaconda.com>
Date: Thu, 28 Aug 2026 12:00:00 +0000
Subject: [PATCH] Drop the Python 2 branch of the x509 typemap

SWIG's own preprocessor does not define PY_MAJOR_VERSION, so it copies the
#else branch of this typemap into the generated wrapper. That branch uses
PyString_Check/PyString_AsString/PyString_Size, which only compiled because
SWIG < 4.3 emitted Python 2 compatibility macros. SWIG 4.3 removed them, so
keep only the Python 3 branch.
---
--- a/src/SWIG/_x509.i
+++ b/src/SWIG/_x509.i
@@ -191,19 +191,11 @@ extern ASN1_OBJECT *X509_NAME_ENTRY_get_object(X509_NAME_ENTRY *);
 extern ASN1_STRING *X509_NAME_ENTRY_get_data(X509_NAME_ENTRY *);
 
 %typemap(in) (const unsigned char *, int) {
-#if PY_MAJOR_VERSION >= 3
     if (PyBytes_Check($input)) {
         Py_ssize_t len;
 
         $1 = PyBytes_AsString($input);
         len = PyBytes_Size($input);
-#else
-    if (PyString_Check($input)) {
-        Py_ssize_t len;
-
-        $1 = (unsigned char *)PyString_AsString($input);
-        len = PyString_Size($input);
-#endif // PY_MAJOR_VERSION >= 3
 
         if (len > INT_MAX) {
             PyErr_SetString(_x509_err, "object too large");
