From 5555555555555555555555555555555555555555 Mon Sep 17 00:00:00 2001
From: conda-forge <conda-forge@anaconda.com>
Date: Thu, 28 Aug 2026 12:00:00 +0000
Subject: [PATCH] Do not corrupt test cookies into control characters

_corrupt_part_str shifts characters by +13, which turns the base64 'r'
into DEL (0x7f). http.cookies rejects control characters since the fix
for CVE-2026-0672, so test_cookie_str_changed_mac fails whenever the
digest happens to have an 'r' at the corrupted offset -- roughly 3% of
runs. Wrap within printable ASCII instead, as upstream does in 0.48.0.
---
--- a/tests/test_authcookie.py
+++ b/tests/test_authcookie.py
@@ -36,8 +36,18 @@ class AuthCookieTestCase(unittest.TestCase):
     def tearDown(self):
         pass
 
+    @staticmethod
+    def _corrupt_char(c: str) -> str:
+        """Shift character within printable ASCII range (0x21-0x7e).
+
+        Unlike the naive ``chr(ord(c) + 13)`` this avoids producing
+        control characters which are rejected by ``http.cookies`` since
+        the fix for CVE-2026-0672.
+        """
+        return chr(0x21 + (ord(c) - 0x21 + 13) % (0x7e - 0x21 + 1))
+
     def _corrupt_part_str(self, s: str, fr: int, to: int) -> str:
-        out = s[:fr] + "".join([chr(ord(x) + 13) for x in s[fr:to]]) + s[to:]
+        out = s[:fr] + "".join([self._corrupt_char(x) for x in s[fr:to]]) + s[to:]
         self.assertNotEqual(s, out)
         return out
 
